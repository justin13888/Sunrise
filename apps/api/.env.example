# Google OAuth credentials (REQUIRED - server refuses to start without them)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# JWT signing secret. REQUIRED in production (NODE_ENV=production).
# In development, an ephemeral random secret is generated if unset.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Comma-separated CORS allowlist (exact origin match, no credentials).
# Default: http://localhost:1420,http://tauri.localhost,tauri://localhost
ALLOWED_ORIGINS=http://localhost:1420,http://tauri.localhost,tauri://localhost

# postMessage target origin for the OAuth callback page (web popup flow).
# Default: first entry of ALLOWED_ORIGINS
FRONTEND_ORIGIN=http://localhost:1420

# Server
PORT=3000

# Database path (defaults to data/sunrise.db relative to cwd)
DB_PATH=data/sunrise.db

# Debug logging
NODE_ENV=development
DEBUG=false
DEBUG_VERBOSE=false
