# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here  
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# Server Configuration
PORT=3000

# CORS Configuration
ALLOWED_ORIGINS=*

# Environment & Debug Configuration
NODE_ENV=development

# Debug logging configuration
# Set to 'true' to enable basic debug logging for all endpoints
DEBUG=true

# Set to 'true' to enable verbose debug logging (includes headers and request bodies)
# WARNING: This may log sensitive information, use only in development
DEBUG_VERBOSE=false
