{
    "name": "@sunrise/api",
    "module": "src/index.ts",
    "type": "module",
    "scripts": {
        "codegen": "graphql-codegen --config codegen.ts",
        "dev:server": "bun run --watch src/server.ts",
        "start": "bun run src/server.ts",
        "dev": "bun run codegen && bun run dev:server",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@graphql-tools/schema": "^10.0.6",
        "@sunrise/gcal": "workspace:*",
        "drizzle-orm": "^0.45.1",
        "graphql": "^16.9.0",
        "graphql-scalars": "^1.23.0",
        "graphql-ws": "^6.0.6",
        "graphql-yoga": "^5.16.2",
        "hono": "^4.9.8"
    },
    "devDependencies": {
        "@graphql-codegen/cli": "^6.0.0",
        "@graphql-codegen/typescript": "^5.0.0",
        "@graphql-codegen/typescript-operations": "^5.0.0",
        "@graphql-codegen/typescript-resolvers": "^5.0.0",
        "@types/better-sqlite3": "^7.6.13",
        "@types/bun": "latest",
        "@types/node": "^24.5.2",
        "better-sqlite3": "^12.5.0",
        "drizzle-kit": "^0.31.8",
        "typescript": "^5.0.0"
    },
    "peerDependencies": {
        "typescript": "^5.0.0"
    }
}
