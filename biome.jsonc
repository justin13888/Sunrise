{
    "$schema": "https://biomejs.dev/schemas/2.3.11/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": false,
        "includes": [
            "**",
            "!legacy",
            "!**/dist",
            "!**/build",
            "!**/coverage",
            "!.claude"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "double"
        }
    },
    "css": {
        "parser": {
            "tailwindDirectives": true
        }
    },
    // `packages/sunrise-ui-tokens/generated/` is written by `mise run tokens`
    // and drift-checked against the TOML that produced it, so it is not ours to
    // *format*: `lefthook.yaml`'s pre-commit `biome check --write .` would
    // otherwise rewrite a generated file, and pre-push would then fail with
    // "stale; regenerate it" while naming the wrong cause.
    //
    // Only the formatter is off. Parsing and linting stay on, and that half
    // matters: `tokens.css` is the one generated output with no other parser
    // anywhere — `tokens.rs` gets `rustc` and `rustfmt` from
    // `mise run tokens-check`, `tokens.swift` is compiled by Xcode and
    // `tokens.ts` by `mise run typecheck`, but no gate builds `apps/web`, so
    // Vite never sees the stylesheet. Excluding the directory outright would
    // have left it unparsed by anything.
    "overrides": [
        {
            "includes": ["packages/sunrise-ui-tokens/generated/**"],
            "formatter": { "enabled": false }
        },
        {
            // `schemas/openapi.v1.json` is generated by `mise run openapi`, not
            // written by hand: `cargo run -p sunrise-server --bin openapi`
            // serializes it with serde_json's pretty printer, which indents two
            // spaces and expands every object and array. Biome's repo-wide
            // defaults (four spaces, arrays collapsed when they fit) would
            // reformat it, and the `openapi-current` CI job regenerates the file
            // and fails on `git diff --exit-code` — so the two gates can only
            // both pass if Biome is told to expect exactly what the generator
            // emits. Keeping Biome on the file rather than excluding it means
            // the JSON is still parsed and linted.
            //
            // Scoped to this one path on purpose: `schemas/log-record.v1.json`
            // is hand-written and follows the repo's four-space style.
            "includes": ["schemas/openapi.v1.json"],
            "json": {
                "formatter": {
                    "indentWidth": 2,
                    "expand": "always"
                }
            }
        }
    ],
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    }
}
