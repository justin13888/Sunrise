{
    "$schema": "https://biomejs.dev/schemas/2.3.11/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": false,
        "includes": [
            "**",
            "!legacy",
            "!**/dist",
            "!**/build",
            "!**/coverage",
            "!.claude",
            // Written by `mise run tokens` and drift-checked against the TOML
            // that produced it, so it is not ours to format — the same reason
            // `apps/apple/.swiftlint.yml` excludes it. Without this,
            // `lefthook.yaml`'s pre-commit `biome check --write .` would
            // rewrite a generated file and pre-push would then fail with
            // "stale; regenerate it", naming the wrong cause.
            "!packages/sunrise-ui-tokens/generated"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "double"
        }
    },
    "css": {
        "parser": {
            "tailwindDirectives": true
        }
    },
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    }
}
