{
    "$comment": "The relay URL rule's cases, read by crates/sunrise-client-core/src/relay_url.rs and apps/web/src/server-url.test.ts. Each case names the origin an input becomes or the issue that refuses it. {256} in an input stands for 256 'a's. The host of 25 'aü' labels is 107 bytes as typed and 257 as an origin, because IDNA writes each label as xn--a-tfa.",
    "cases": [
        { "input": "https://relay.example", "origin": "https://relay.example" },
        {
            "input": "https://relay.example/",
            "origin": "https://relay.example"
        },
        {
            "input": "  https://Relay.Example:8443/  ",
            "origin": "https://relay.example:8443"
        },
        { "input": "HTTPS://RELAY.EXAMPLE", "origin": "https://relay.example" },
        {
            "input": "https://relay.example:443",
            "origin": "https://relay.example"
        },
        {
            "input": "https://bücher.example",
            "origin": "https://xn--bcher-kva.example"
        },
        { "input": "http://localhost:8443", "origin": "http://localhost:8443" },
        {
            "input": "http://LOCALHOST:3000/",
            "origin": "http://localhost:3000"
        },
        { "input": "http://127.0.0.1:8443", "origin": "http://127.0.0.1:8443" },
        { "input": "http://127.0.0.2:3000", "origin": "http://127.0.0.2:3000" },
        { "input": "http://[::1]:8443", "origin": "http://[::1]:8443" },
        { "input": "https://10.0.0.1:8443", "origin": "https://10.0.0.1:8443" },
        { "input": "", "issue": "empty" },
        { "input": "   ", "issue": "empty" },
        { "input": "https://{256}.example", "issue": "too_long" },
        {
            "input": "https://aü.aü.aü.aü.aü.aü.aü.aü.aü.aü.aü.aü.aü.aü.aü.aü.aü.aü.aü.aü.aü.aü.aü.aü.aü",
            "issue": "too_long"
        },
        { "input": "relay.example", "issue": "not_a_url" },
        { "input": "not a url", "issue": "not_a_url" },
        { "input": "https://", "issue": "not_a_url" },
        { "input": "wss://relay.example/sync", "issue": "web_socket" },
        { "input": "ws://127.0.0.1:8443", "issue": "web_socket" },
        { "input": "ftp://relay.example", "issue": "unsupported_scheme" },
        { "input": "javascript:alert(1)", "issue": "unsupported_scheme" },
        { "input": "file:///etc/hosts", "issue": "unsupported_scheme" },
        { "input": "http://relay.example", "issue": "insecure_remote" },
        { "input": "http://10.0.0.1", "issue": "insecure_remote" },
        { "input": "http://192.168.1.10:8443", "issue": "insecure_remote" },
        { "input": "https://relay.example/sync", "issue": "not_an_origin" },
        { "input": "https://relay.example/?token=x", "issue": "not_an_origin" },
        { "input": "https://relay.example?", "issue": "not_an_origin" },
        { "input": "https://relay.example/#x", "issue": "not_an_origin" },
        { "input": "https://relay.example#", "issue": "not_an_origin" },
        { "input": "https://user:pw@relay.example", "issue": "not_an_origin" },
        { "input": "https://user@relay.example", "issue": "not_an_origin" },
        { "input": "http://relay.example/sync", "issue": "not_an_origin" }
    ]
}
