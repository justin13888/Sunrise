  "components": {
    "schemas": {
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "description": "`\"ok\"` while the server is healthy."
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "description": "Health response.\n\n`Deserialize` is here for the generated client, not for the server: spargen\nreads this shape out of the document and the client decodes into it."
      },
      "MetaResponse": {
        "properties": {
          "server_app_v": {
            "type": "string",
            "description": "Server's `<semver>+<platform>` string."
          },
          "wire_proto_supported": {
            "items": {
              "type": "integer",
              "maximum": 4294967295.0,
              "minimum": 0.0,
              "format": "uint32"
            },
            "type": "array",
            "description": "Wire-protocol versions the server speaks."
          },
          "crypto_suite_supported": {
            "items": {
              "type": "integer",
              "maximum": 4294967295.0,
              "minimum": 0.0,
              "format": "uint32"
            },
            "type": "array",
            "description": "Crypto-suite versions the server speaks."
          },
          "doc_schema_floor": {
            "type": "integer",
            "maximum": 4294967295.0,
            "minimum": 0.0,
            "format": "uint32",
            "description": "Server's `doc_schema_floor` (lowest accepted)."
