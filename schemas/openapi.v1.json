      "PushPlatform": {
        "type": "string",
        "enum": [
          "apns",
          "fcm",
          "webpush"
        ],
        "description": "Push platform tag.\n\n`kynos::Schema` so the typed surface can take this directly rather than a\nfree string: the three platforms then appear in the OpenAPI document as an\nenum, and an unknown one is rejected by the parse rather than stored."
      },
      "PushRegistration": {
        "properties": {
          "device_id": {
            "type": "string",
            "description": "Which of the caller's devices this token belongs to. Validated against\nthe caller's own rows; it cannot file a token under an unowned device."
          },
          "platform": {
            "$ref": "#/components/schemas/PushPlatform",
            "description": "Provider tag.\n\nThe enum rather than a free string: a token filed under a platform no\nprovider serves is a notification that silently never arrives, and the\nparse is the cheapest place to refuse it."
          },
          "token": {
            "type": "string",
            "description": "The provider token. Stored in plaintext today — see\n`docs/01-architecture/threat-model.md`."
