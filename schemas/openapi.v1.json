        "summary": "Revoke a device.",
        "description": "**Only callable from another paired device.** A device that can revoke\nitself is a device a thief can use to erase the evidence of its own theft,\nand the legitimate \"sign out here\" gesture is a local key wipe rather than a\nserver call.",
        "operationId": "revoke",
        "parameters": [
          {
            "name": "device_id",
            "in": "path",
            "description": "The device being addressed.",
            "required": true,
            "schema": {
              "type": "string"
