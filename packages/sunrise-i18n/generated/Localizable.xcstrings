      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing stopped"
          }
        }
      }
    },
    "apple.pairing.finishing_joining": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening your vault on this %1$@…"
          }
        }
      }
    },
    "apple.pairing.finishing_sponsoring": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sealing your vault key for the other device…"
          }
        }
      }
    },
    "apple.pairing.legs.code_instruction": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan the code, or copy the text below and paste it into Settings › Vaults › Add a device on your other device — the one that already has your vault."
          }
        }
      }
    },
    "apple.pairing.legs.code_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show this to the device that has your vault"
          }
        }
      }
    },
    "apple.pairing.legs.grant_instruction": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the certificate admitting that device to your account, and your vault key, sealed so that only the device whose digits you just confirmed can open it. Anything it passes through on the way — a message, a clipboard, a relay — sees nothing usable."
          }
        }
      }
    },
    "apple.pairing.legs.grant_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy this last block to the other device"
          }
        }
      }
    },
    "apple.pairing.legs.message_instruction": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste it into the field the other device is showing, then come back here and continue."
          }
        }
      }
    },
    "apple.pairing.legs.message_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy this to the other device"
          }
        }
      }
    },
    "apple.pairing.legs.offer_instruction": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This says who your account is. It carries no keys — the other device replies with keys of its own, and only then does anything of yours leave this one."
          }
        }
      }
    },
    "apple.pairing.legs.offer_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy this to the device you are adding"
          }
        }
      }
    },
    "apple.pairing.legs.prompt_code_instruction": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That device is showing a QR code with the same text underneath it. Scan it with the camera, or paste the text here."
          }
        }
      }
    },
    "apple.pairing.legs.prompt_code_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan the code on the device you are adding"
          }
        }
      }
    },
    "apple.pairing.legs.prompt_grant_instruction": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other device is showing one last block, now that you have both confirmed the digits. It is the only thing in this whole exchange that carries your vault key."
          }
        }
      }
    },
    "apple.pairing.legs.prompt_grant_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste the sealed certificate and key"
          }
        }
      }
    },
    "apple.pairing.legs.prompt_message_instruction": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy the block from the other device's screen and paste it here."
          }
        }
      }
    },
    "apple.pairing.legs.prompt_message_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste what the other device is showing"
          }
        }
      }
