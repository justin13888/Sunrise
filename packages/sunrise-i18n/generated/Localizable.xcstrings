        }
      }
    },
    "apple.onboarding.restore": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore from recovery code"
          }
        }
      }
    },
    "apple.onboarding.restore_caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No other device left? Your twenty-four words bring the account back."
          }
        }
      }
    },
    "apple.onboarding.welcome": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome to Sunrise"
          }
        }
      }
    },
    "apple.pairing.account_explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunrise puts a four-byte hash of this address in the pairing code so the other device can tell it is being asked about the right account. The address itself does not travel."
          }
        }
      }
    },
    "apple.pairing.account_question": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which account is this?"
          }
        }
      }
    },
    "apple.pairing.account_tag": {
