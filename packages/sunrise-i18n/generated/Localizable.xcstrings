          "stringUnit": {
            "state": "translated",
            "value": "There is a vault on this device, but its key is not in this Keychain. Pair with a device that still has it, or restore from your recovery code. A new key would not open this data."
          }
        }
      }
    },
    "apple.locked.key_missing_caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing brings the key back from a device that still has it. The data already on this %1$@ stays where it is — the key is the only thing that was missing. With no device left, the recovery code restores the account from the relay; the unreadable vault is moved aside, not deleted."
          }
        }
      }
    },
