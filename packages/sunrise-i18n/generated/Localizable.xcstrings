        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other device has a certificate from your account and a copy of your vault key."
          }
        }
      }
    },
    "apple.pairing.email": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
