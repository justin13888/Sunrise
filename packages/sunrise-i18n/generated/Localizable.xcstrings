          "stringUnit": {
            "state": "translated",
            "value": "Create my vault"
          }
        }
      }
    },
    "apple.onboarding.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your tasks are encrypted on this %1$@ with a key only you hold. Sunrise stores it in your Keychain — it never leaves the device, and no server can read your data with or without it."
          }
        }
      }
    },
    "apple.onboarding.pair": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair with that device"
          }
        }
      }
    },
    "apple.onboarding.pair_caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adopts the vault you already have, instead of starting a second one."
