    "apple.devices.gated_reason": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This %1$@ has itself been removed from the account, so the account discards its removals of other devices. %2$@ is still current everywhere and still receives new keys, and this removal tells the relay nothing."
          }
        }
      }
    },
    "apple.devices.gated_remedy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove it from a device the account still trusts. The request is kept, not discarded, and is reconsidered whenever another removal arrives."
          }
        }
      }
    },
    "apple.devices.gated_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ was NOT removed."
          }
        }
      }
    },
    "apple.devices.identity_key": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This %1$@ holds the account identity key. Your recovery code is its only other copy: without one, losing this device destroys the key permanently, and no recovery feature added later can retrieve it."
          }
        }
      }
    },
    "apple.devices.mark_admitted_after_revocation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Joined after a device was removed. Usually that is just a device you added later; it is worth a look if it is not."
          }
        }
      }
    },
    "apple.devices.mark_not_current": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not active on this account — the identity that certified it is no longer the one in force. An honest device that has not caught up with a change yet looks the same."
          }
        }
      }
    },
    "apple.devices.mark_read_bounded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removed earlier. The account no longer records that, so it shows as current — but it still receives no keys and reads nothing written since. Remove it again from a device you still trust."
          }
        }
      }
    },
    "apple.devices.mark_removed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removed. It reads nothing written since."
          }
        }
      }
    },
    "apple.devices.mark_this_device": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This %1$@."
          }
        }
